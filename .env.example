# ============================================================================
# CONFIGURATION SERVEUR VERCEL — VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Copiez ce fichier vers .env.local pour vos tests locaux avec 'vercel dev'.
# Sur le dashboard Vercel en production : Settings > Environment Variables.
# 
# IMPORTANT : Toutes ces variables sont STRICTEMENT SERVEUR (aucun préfixe NEXT_PUBLIC_).
# Elles ne sont JAMAIS exposées au navigateur public des répondants.

# 1. URL du déploiement Google Apps Script (Web App)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_DEPLOYMENT_ID/exec

# 2. Mot de passe de protection de l'accès au Dashboard KPI (/dashboard)
# Recommandé : Choisir un mot de passe robuste réservé au porteur du projet
DASHBOARD_PASSWORD=Definir_Un_Mot_De_Passe_Robuste_2026

# 3. Clé secrète partagée pour la lecture des données analytiques entre Vercel et Google Apps Script
# Doit correspondre à la propriété DASHBOARD_API_KEY dans les Propriétés du script Google Apps Script
DASHBOARD_API_KEY=cm_sondage_analytics_secret_2026
